# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. Never commit your real `.env`.

# Required: OpenRouter API key used by healer.py to repair broken selectors.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: override the model used by the healer.
# Default (set in healer.py): qwen/qwen3.7-flash
# HEALER_MODEL=qwen/qwen3.7-flash

# Optional: enable verbose LLM logging in healer.py.
# When set to 1/true/yes/on, every raw LLM reply is dumped (untruncated)
# and `_diagnose_llm_response` runs sanity checks for:
#   - refusal phrases ("I cannot decide", "as an AI", ...)
#   - hallucinated method names ("fix_it_with_magic", ...)
#   - broken JSON syntax in JSON-shaped outputs.
# The dump appears between [AI Healer][DEBUG] === markers. Use this when
# investigating "automation ends silently on the password page" type bugs.
# HEALER_DEBUG=1

# Required: Google account credentials for the test flow in runner.py.
TEST_GMAIL_USER=your_email@gmail.com
TEST_GMAIL_PASS=your_app_password

# Optional: override the 2FA method configured in config.json -> 2fa_settings.method.
# Options: google_prompt (default), sms, voice, totp, security_key
# When unset, the value from config.json is used.
# GMAIL_2FA_METHOD=google_prompt