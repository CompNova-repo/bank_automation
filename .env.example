# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. Never commit your real `.env`.

# Required: OpenRouter API key used by healer.py to repair broken selectors.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: override the model used by the healer.
# Default (set in healer.py): qwen/qwen3.7-flash
# HEALER_MODEL=qwen/qwen3.7-flash

# Required: Google account credentials for the test flow in runner.py.
TEST_GMAIL_USER=your_email@gmail.com
TEST_GMAIL_PASS=your_app_password
