{
  "bank_name": "Google Account Test Flow",
  "login_url": "https://accounts.google.com/signin/v2/identifier?flowName=GlifWebSignIn&flowEntry=ServiceLogin",
  "download_dir": "C:\\Temp",
  "timeout_seconds": 15,
  "2fa_settings": {
    "enabled": true,
    "method": "google_prompt",
    "approval_timeout_seconds": 60,
    "poll_interval_seconds": 2
  },
  "flow_steps": [
    {
      "step_name": "enter_email",
      "intent": "The input field where the user enters their email or phone username",
      "action": "type",
      "selector": "[jsname='YPqjbf']",
      "value_env": "TEST_GMAIL_USER"
    },
    {
      "step_name": "click_next_email",
      "intent": "The primary Next or Continue button after entering the email address",
      "action": "click",
      "selector": "#identifierNext"
    },
    {
      "step_name": "wait_for_password_screen",
      "action": "sleep",
      "duration": 4
    },
    {
      "step_name": "enter_password",
      "intent": "The password input field where the user enters their password",
      "action": "type",
      "selector": "input[type=\"password\"]",
      "value_env": "TEST_GMAIL_PASS"
    },
    {
      "step_name": "click_next_password",
      "intent": "The primary Next or Sign in button after entering the password",
      "action": "click",
      "selector": "#passwordNext"
    },
    {
      "step_name": "select_2fa_method",
      "intent": "On the 2-Step Verification page, click the option matching the user's intent. The user wants to use Google Prompt (a fast push notification to their phone to tap Yes). If the chooser is not visible or the prompt has already been sent automatically, do nothing - the next step will wait for the URL to advance after approval.",
      "action": "click_text",
      "selector": "",
      "optional": true
    },
    {
      "step_name": "wait_for_2fa_approval",
      "action": "wait_for_url_change",
      "contains": [
        "myaccount.google.com",
        "mail.google.com",
        "oauth"
      ],
      "not_contains": [
        "signin/v2/challenge",
        "signin/v2/identifier",
        "v3/signin/challenge",
        "challenge/selection"
      ],
      "timeout_seconds": 60
    }
  ]
}